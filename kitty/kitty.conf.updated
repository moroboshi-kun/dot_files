############################
# Theme
############################

include tokyo_night_moon.conf


############################
# Font
############################

font_family      JetBrainsMono Nerd Font
bold_font        auto
italic_font      auto
bold_italic_font auto
font_size        12.5

enable_ligatures yes


############################
# Appearance
############################

cursor_shape block
cursor_blink_interval 0

scrollback_lines 10000
window_padding_width 10

enable_audio_bell no
copy_on_select yes


############################
# Performance
############################

repaint_delay 10
input_delay 3
sync_to_monitor yes


############################
# Tabs
############################

tab_bar_edge top
tab_bar_style powerline
tab_powerline_style slanted
tab_title_template "{index}: {title}"

############################
# Layouts
############################

# Enable tall + splits + stack
enabled_layouts tall:bias=60;full_size=1;mirrored=false,splits,stack

# Start in tall to test it
startup_layout tall

############################
# Splits / Window Management
############################

# Horizontal split (top/bottom)
map ctrl+alt+enter launch --location=hsplit

# Vertical split (left/right)
map ctrl+alt+v launch --location=vsplit

# Promote pane to main
map ctrl+shift+enter move_window_to_top

# Close pane
map ctrl+shift+w close_window

# Vim-style pane navigation
map ctrl+shift+h neighboring_window left
map ctrl+shift+l neighboring_window right
map ctrl+shift+k neighboring_window up
map ctrl+shift+j neighboring_window down

# Resize panes
map ctrl+shift+left  resize_window wider 5
map ctrl+shift+right resize_window narrower 5
map ctrl+shift+up    resize_window taller 5
map ctrl+shift+down  resize_window shorter 5

# Cycle layouts: tall → splits → stack → tall
map ctrl+shift+space next_layout
