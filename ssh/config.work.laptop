# Personal BitBucket account
Host bitbucket.org
    Hostname bitbucket.org
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/BitBucket/bitbucket_personal_ed

# Work BitBucket account
Host bitbucket.org-work
    Hostname bitbucket.org
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/BitBucket/bitbucket_work_ed

# Just Add Power Workspace BitBucket Account
Host bitbucket.org-workspace
    Hostname bitbucket.org
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/BitBucket/bitbucket_workspace_ed

# Personal Github account
Host github.com
    Hostname github.com
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/GitHub/github_personal_ed

# Personal Github account - alternate
Host github.com-mkun
    Hostname github.com
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/GitHub/github_moroboshi_ed

# Professional Github account
Host github.com-pro
    Hostname github.com
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/GitHub/github_professional_ed

# Personal GitLab account
Host gitlab.com-p2
    Hostname gitlab.com
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/GitLab/gitlab_personal_ed

Host gitlab.com
    Hostname gitlab.com
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/GitLab/gitlab_animalchin_ed

# Work GitLab account
Host gitlab.com-work
    Hostname gitlab.com
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/GitLab/gitlab_work_ed

# ----- AWS ----- #
Host simple-help
    Hostname ec2-54-213-132-62.us-west-2.compute.amazonaws.com
    User ec2-user
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/AWS/admin-access.pem

Host cupola-cloud
    Hostname ec2-34-233-36-102.compute-1.amazonaws.com
    User ubuntu
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/Documents/Work/AWS/access_keys/aws_camera_server_ed.pem
    StrictHostKeyChecking no

Host git-codecommit.*.amazonaws.com
    User APKAUHMXMX2BM4VUIBKM
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/AWS/work/mikef/aws-cc_rsa

# ----- Digital Ocean ----- #

Host grafana-cloud
    Hostname grafana.iacdev.net
    User root
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/DO/grafana_ed
    StrictHostKeyChecking no

