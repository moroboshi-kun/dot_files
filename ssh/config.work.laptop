#    Mike F
#    2020-05-27
#    /home/mike/.ssh/config
#    local ssh config file for ubuntu laptop
#
### default for all ###
IdentitiesOnly yes
HostKeyAlgorithms = +ssh-rsa
PubkeyAcceptedAlgorithms = +ssh-rsa


### override per host ###
Host devstar
	Hostname 10.4.19.92 
	User mike
  AddKeysToAgent yes
  # IdentitiesOnly yes
	IdentityFile /home/mike/.ssh/default/default_ed

Host dev1.server.justaddpower
	Hostname 10.4.19.77 
	User dev
  AddKeysToAgent yes
  # IdentitiesOnly yes
	IdentityFile /home/mike/.ssh/id_ed25519
  
Host c360.server.justaddpower
	Hostname 10.4.19.48 
	User mikef
  AddKeysToAgent yes
  # IdentitiesOnly yes
	IdentityFile /home/mike/.ssh/id_ed25519

