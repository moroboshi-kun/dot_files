#    Mike F
#    2024-08-03
#    /home/mike/.ssh/config
#    default ssh config file for my ubuntu machines
#
### default for all ###
HostKeyAlgorithms = +ssh-rsa
PubkeyAcceptedAlgorithms = +ssh-rsa


### override per host ###

# Personal BitBucket account
Host bitbucket.org
    Hostname bitbucket.org
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/bitbucket/personal/id_ed25519

# Work BitBucket account
Host bitbucket.org-work
    Hostname bitbucket.org
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/bitbucket/work/id_ed25519

# Personal Github account - pro account
Host github.com
    Hostname github.com
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/github/onsokumaru/id_ed25519

# Personal Github account - secondary
Host github.com-mkun
    Hostname github.com
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/github/moroboshi/id_ed25519

# Personal GitLab account
Host gitlab.com
    Hostname gitlab.com
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/gitlab/moroboshi/id_ed25519

# Personal GitLab account - alternate
Host gitlab.com
    Hostname gitlab.com
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/gitlab/animalchin/id_ed25519

