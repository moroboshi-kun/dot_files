#    Mike F
#    local ssh config file (home desktop)
#    Managed by ubuntu-desktop-ansible (ssh role)
#
### default for all ###
Host *
    SetEnv TERM=xterm-256color

# Machine-local / sensitive hosts (AWS, private infra, etc.) belong here.
# Not committed to the dotfiles repo; ssh silently skips it if absent.
Include ~/.ssh/config.local

# --------------------------------
#     GITHUB
# --------------------------------
# Personal GitHub account
Host github.com
    Hostname github.com
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/GitHub/github_personal_ed

# Personal GitHub account - alternate (moroboshi)
Host github.com-mkun
    Hostname github.com
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/GitHub/gh_moroboshi_ed

# Professional GitHub account
Host github.com-pro
    Hostname github.com
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/GitHub/github_professional_ed

# --------------------------------
#     GITLAB
# --------------------------------
# Personal GitLab account (moroboshi) - primary.
# gitconfig insteadOf rewrites git@gitlab.com -> git@gitlab.com-mkun,
# so this alias must exist.
Host gitlab.com-mkun
    Hostname gitlab.com
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/GitLab/gitlab_personal_ed

# Personal GitLab account - alternate (animalchin)
Host gitlab.com-animalchin
    Hostname gitlab.com
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/GitLab/gitlab_animalchin_ed

# --------------------------------
#     BITBUCKET
# --------------------------------
# Personal BitBucket account
Host bitbucket.org
    Hostname bitbucket.org
    User git
    AddKeysToAgent yes
    IdentitiesOnly yes
    IdentityFile ~/.ssh/BitBucket/bitbucket_personal_ed
