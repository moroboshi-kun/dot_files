add_newline = true

format = """
[░▒▓](#a3aed2)\
[ 󰣛 ](bg:#a3aed2 fg:#090c0c)\
[](bg:#769ff0 fg:#a3aed2)\
$directory\
[](fg:#769ff0 bg:#394260)\
$git_branch\
$git_status\
[](fg:#394260 bg:#212736)\
$c\
$cpp\
$rust\
$golang\
$nodejs\
$php\
$java\
$kotlin\
$haskell\
$python\
$terraform\
[](fg:#212736 bg:#1d2230)\
$docker_context\
$conda\
$pixi\
[](fg:#1d2230 bg:#1a1b26)\
$time\
[ ](fg:#1a1b26)\
\n$character
"""

# --------------------
# Core modules
# --------------------

[directory]
style = "fg:#e3e5e5 bg:#769ff0"
format = "[ $path ]($style)"
truncation_length = 3
truncation_symbol = "…/"

[git_branch]
symbol = ""
style = "bg:#394260"
format = '[[ $symbol $branch ](fg:#769ff0 bg:#394260)]($style)'

[git_status]
style = "bg:#394260"
format = '[[($all_status$ahead_behind )](fg:#769ff0 bg:#394260)]($style)'

# --------------------
# Language modules
# --------------------

[package]
disabled = true

[c]
symbol = " "
style = "fg:#769ff0 bg:#212736"
format = "[ $symbol($version) ]($style)"

[cpp]
symbol = " "
style = "fg:#769ff0 bg:#212736"
format = "[ $symbol($version) ]($style)"

[rust]
symbol = " "
style = "fg:#769ff0 bg:#212736"
format = "[ $symbol($version) ]($style)"

[golang]
symbol = " "
style = "fg:#769ff0 bg:#212736"
format = "[ $symbol($version) ]($style)"

[nodejs]
symbol = " "
style = "fg:#769ff0 bg:#212736"
format = "[ $symbol($version) ]($style)"

[php]
symbol = " "
style = "fg:#769ff0 bg:#212736"
format = "[ $symbol($version) ]($style)"

[java]
symbol = " "
style = "fg:#769ff0 bg:#212736"
format = "[ $symbol($version) ]($style)"

[kotlin]
symbol = " "
style = "fg:#769ff0 bg:#212736"
format = "[ $symbol($version) ]($style)"

[haskell]
symbol = " "
style = "fg:#769ff0 bg:#212736"
format = "[ $symbol($version) ]($style)"

[python]
symbol = " "
style = "fg:#769ff0 bg:#212736"
format = "[ $symbol($version) ]($style)"

[terraform]
symbol = "󱁢 "
style = "fg:#769ff0 bg:#212736"
format = "[ $symbol($version) ]($style)"
# --------------------
# Environment modules
# --------------------

[docker_context]
symbol = " "
style = "fg:#83a598 bg:#1d2230"
format = "[ $symbol$context ]($style)"

[conda]
symbol = " "
style = "fg:#83a598 bg:#1d2230"
format = "[ $symbol$environment ]($style)"

[pixi]
symbol = "󰏗 "
style = "fg:#83a598 bg:#1d2230"
format = "[ $symbol$environment ]($style)"

# --------------------
# Time
# --------------------

[time]
disabled = false
time_format = "%R"
style = "fg:#a0a9cb bg:#1a1b26"
format = "[  $time ]($style)"

# --------------------
# Prompt character
# --------------------

[character]
success_symbol = "[❯](bold green)"
error_symbol = "[❯](bold red)"
