add_newline = false

format = "$directory $git_branch$git_status$git_state$character"

[directory]
style = "bold blue"

[git_branch]
format = "[$branch]($style) "
style = "bold green"

[git_status]
format = "([$staged$modified$untracked$ahead_behind]($style) )"
style = "bold yellow"

staged = "+$count "
modified = "!$count "
untracked = "?$count "

ahead = "⇡$count "
behind = "⇣$count "
diverged = "⇡$ahead_count ⇣$behind_count "

[git_metrics]
disabled = true

[git_state]
format = '\([$state( $progress_current/$progress_total)]($style)\) '
style = "bold red"

[character]
success_symbol ="➜  "
error_symbol = "➜  "
