# get running instances Instance ID, name, private and public IP, and instance type

aws-running-instances() {
  aws ec2 describe-instances \
    --filters "Name=instance-state-name,Values=running" \
    --query 'Reservations[*].Instances[*].{
      Instance: InstanceId,
      Name: Tags[?Key==`Name`]|[0].Value,
      PrivateIP: PrivateIpAddress,
      PublicIP: PublicIpAddress,
      Type: InstanceType
    }' \
    --output table
}

aws-available-vpcs() {
  aws ec2 describe-vpcs \
    --filters "Name=state,Values=available" \
    --query 'Vpcs[*].{
      VpcID: VpcId,
      Name: Tags[?Key==`Name`]|[0].Value,
      CidrBlock: CidrBlock
    }' \
    --output table
}

ec2az() {
  if [ -z "$1" ]; then
    echo "Usage: ec2az <instance-id>"
    return 1
  fi

  aws ec2 describe-instances \
    --instance-ids "$1" \
    --query 'Reservations[].Instances[].{AZ:Placement.AvailabilityZone, AZId:Placement.AvailabilityZoneId}' \
    --output table
}

ec2_volumes() {
  local INSTANCE_ID=$1

  # If no instance ID provided, try IMDSv2
  if [ -z "$INSTANCE_ID" ]; then
    local TOKEN=$(curl -s --connect-timeout 1 -X PUT "http://169.254.169.254/latest/api/token" \
      -H "X-aws-ec2-metadata-token-ttl-seconds: 21600")

    if [ -z "$TOKEN" ]; then
      echo "Error: No instance ID provided and IMDS is not available."
      echo ""
      echo "Usage:"
      echo "  ec2_volumes <instance-id>"
      echo ""
      echo "Example:"
      echo "  ec2_volumes i-1234567890abcdef0"
      return 1
    fi

    INSTANCE_ID=$(curl -s -H "X-aws-ec2-metadata-token: $TOKEN" \
      http://169.254.169.254/latest/meta-data/instance-id)

    if [ -z "$INSTANCE_ID" ]; then
      echo "Error: Failed to retrieve instance ID from IMDS."
      return 1
    fi
  fi

  aws ec2 describe-instances \
    --instance-ids "$INSTANCE_ID" \
    --query "Reservations[*].Instances[*].BlockDeviceMappings[*].{DeviceName:DeviceName,VolumeId:Ebs.VolumeId}" \
    --output table
}
