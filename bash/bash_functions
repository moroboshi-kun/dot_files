# get running instances Instance ID, name, private and public IP, and instance type

aws-running-instances() {
  aws ec2 describe-instances \
    --filters "Name=instance-state-name,Values=running" \
    --query 'Reservations[*].Instances[*].{
      Instance: InstanceId,
      Name: Tags[?Key==`Name`]|[0].Value,
      PrivateIP: PrivateIpAddress,
      PublicIP: PublicIpAddress,
      Type: InstanceType
    }' \
    --output table
}

# get CidrBlock, Name, and VpcId of available VPCs

aws-available-vpcs() {
  aws ec2 describe-vpcs \
    --filters "Name=state,Values=available" \
    --query 'Vpcs[*].{
      VpcID: VpcId,
      Name: Tags[?Key==`Name`]|[0].Value,
      CidrBlock: CidrBlock
    }' \
    --output table
}

# get the Availability Zone and AZ ID of a specific instance

ec2az() {
  if [ -z "$1" ]; then
    echo "Usage: ec2az <instance-id>"
    return 1
  fi

  aws ec2 describe-instances \
    --instance-ids "$1" \
    --query 'Reservations[].Instances[].{AZ:Placement.AvailabilityZone, AZId:Placement.AvailabilityZoneId}' \
    --output table
}
