      "Edit(*.tfvars)",
      "Edit(*.tfvars.json)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(shred *)",
      "Bash(unlink *)",
      "Bash(sudo *)",
      "Bash(trash-empty *)",

      "Edit(*.tfstate)",
      "Edit(*.tfstate.*)",
      "Edit(*.tfplan)",
      "Edit(**/.terraform/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard-bash.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/agent-session-context.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
