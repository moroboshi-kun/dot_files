{
    "name": "kubernetes-docker",
    "description": "Container and orchestration specialist for Dockerfiles, Docker Compose, Kubernetes manifests, Helm charts, Kustomize, container security, image optimization, and cluster debugging.",
    "prompt": "file:///home/mike/.kiro/prompts/kubernetes-docker.md",
    "includeMcpJson": true,
    "tools": [
        "@linear",
        "read",
        "write",
        "shell",
        "grep",
        "glob",
        "code",
        "web_search",
        "web_fetch"
    ],
    "allowedTools": [
        "read",
        "grep",
        "glob",
        "code",
        "web_search",
        "web_fetch"
    ],
    "toolsSettings": {
        "shell": {
            "allowedCommands": [
                "docker build",
                "docker run",
                "docker ps",
                "docker images",
                "docker logs",
                "docker inspect",
                "docker compose",
                "docker exec",
                "docker network",
                "docker volume",
                "kubectl get",
                "kubectl describe",
                "kubectl logs",
                "kubectl apply --dry-run",
                "kubectl diff",
                "kubectl explain",
                "kubectl top",
                "kubectl events",
                "kubectl rollout status",
                "kubectl rollout history",
                "helm template",
                "helm lint",
                "helm show",
                "helm list",
                "helm status",
                "helm diff",
                "kustomize build",
                "hadolint",
                "trivy image",
                "trivy fs",
                "git status",
                "git fetch",
                "git log",
                "git diff",
                "git branch",
                "git checkout",
                "git switch",
                "git add",
                "git commit",
                "git push",
                "git pull",
                "git stash",
                "git tag",
                "git show",
                "git rev-parse"
            ],
            "deniedCommands": [
                "kubectl delete.*",
                "kubectl apply(?!.*--dry-run).*",
                "kubectl edit.*",
                "kubectl drain.*",
                "kubectl cordon.*",
                "helm install.*",
                "helm upgrade.*",
                "helm uninstall.*",
                "docker rm.*",
                "docker rmi.*",
                "docker system prune.*",
                "rm -rf .*",
                "sudo .*",
                "git push --force",
                "git push -f",
                "git reset --hard",
                "git clean -f.*",
                "git branch -D.*"
            ],
            "autoAllowReadonly": true,
            "denyByDefault": false
        }
    },
    "resources": [
        "file://README.md",
        "file://Dockerfile*",
        "file://docker-compose*.yml",
        "file://docker-compose*.yaml",
        "file://**/Chart.yaml",
        "file://**/values.yaml",
        "file://**/kustomization.yaml",
        "file://k8s/**/*.yaml",
        "file://manifests/**/*.yaml",
        "file://helm/**/*",
        "file:///home/mike/.kiro/steering/container-standards.md",
        "file:///home/mike/.kiro/steering/linear-standards.md",
        "file:///home/mike/.kiro/steering/security-baselines.md",
        "skill://~/.kiro/skills/*/SKILL.md"
    ],
    "welcomeMessage": "Kubernetes and Docker agent ready. I can help with containers, manifests, Helm charts, debugging, and image optimization."
}
