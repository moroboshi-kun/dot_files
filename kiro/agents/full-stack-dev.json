{
    "name": "full-stack-dev",
    "description": "Senior full-stack developer proficient in JavaScript, TypeScript, Node.js, Express, React, MongoDB, SQL, and capable of learning new technologies on the fly",
    "prompt": "file:///home/mike/.kiro/prompts/full-stack-dev.md",
    "includeMcpJson": true,
    "tools": [
        "@linear",
        "@chrome-devtools",
        "read",
        "write",
        "shell",
        "grep",
        "glob",
        "code",
        "web_search",
        "web_fetch"
    ],
    "allowedTools": [
        "read",
        "grep",
        "glob",
        "code",
        "web_search",
        "web_fetch"
    ],
    "toolsSettings": {
        "shell": {
            "allowedCommands": [
                "npm",
                "npx",
                "node",
                "pnpm",
                "yarn",
                "tsc",
                "eslint",
                "prettier",
                "jest",
                "vitest",
                "mocha",
                "docker compose",
                "curl",
                "git status",
                "git fetch",
                "git log",
                "git diff",
                "git branch",
                "git checkout",
                "git switch",
                "git add",
                "git commit",
                "git push",
                "git pull",
                "git stash",
                "git tag",
                "git show",
                "git rev-parse"
            ],
            "deniedCommands": [
                "rm -rf .*",
                "sudo .*",
                "git push --force",
                "git push -f",
                "git reset --hard",
                "git clean -f.*",
                "git branch -D.*"
            ],
            "autoAllowReadonly": true,
            "denyByDefault": false
        }
    },
    "resources": [
        "file://package.json",
        "file://tsconfig.json",
        "file://README.md",
        "file://Dockerfile*",
        "file://docker-compose*.yml",
        "file:///home/mike/.kiro/steering/container-standards.md",
        "file:///home/mike/.kiro/steering/linear-standards.md",
        "skill://~/.kiro/skills/*/SKILL.md"
    ],
    "welcomeMessage": "Full-stack dev agent ready. What are we building?"
}
