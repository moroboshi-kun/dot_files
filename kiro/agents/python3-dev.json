{
  "name": "python3-dev",
  "description": "General-purpose Python 3 developer for application code, scripts, tooling, testing, refactoring, debugging, and code quality improvements.",
  "prompt": "file://../prompts/python3-dev.md",
  "includeMcpJson": true,
  "tools": [
    "@github",
    "@linear",
    "@snyk",
    "code",
    "glob",
    "grep",
    "read",
    "shell",
    "write"
  ],
  "allowedTools": [
    "read",
    "grep",
    "glob"
  ],
  "toolsSettings": {
    "shell": {
      "allowedCommands": [
        "python",
        "python3",
        "pip",
        "pip3",
        "pytest",
        "mypy",
        "ruff",
        "black",
        "isort",
        "tox",
        "poetry",
        "pdm",
        "uv",
        "curl",
        "wget",
        "git status",
        "git fetch",
        "git log",
        "git diff",
        "git branch",
        "git checkout",
        "git switch",
        "git add",
        "git commit",
        "git pull",
        "git stash",
        "git tag",
        "git show",
        "git rev-parse",
        "trash-put",
        "trash-list",
        "trash-restore"
      ],
      "deniedCommands": [
        "sudo.*",
        "^\\s*rm(\\s|$)",
        "^\\s*rmdir(\\s|$)",
        "^\\s*shred(\\s|$)",
        "^\\s*unlink(\\s|$)",
        "find\\s.*-delete",
        "find\\s.*-exec\\s+rm",
        "(curl|wget).*\\|.*(sh|bash|zsh|dash).*",
        "git push",
        "git push.*(--force|-f).*",
        "git reset.*--hard.*",
        "git clean.*-[a-zA-Z]*f.*",
        "git branch.*-D.*"
      ],
      "autoAllowReadonly": true,
      "denyByDefault": false
    }
  },
  "resources": [
    "file://README.md",
    "file://pyproject.toml",
    "file://requirements.txt",
    "file://requirements-dev.txt",
    "file://setup.py",
    "file://setup.cfg",
    "file://pytest.ini",
    "file://tox.ini",
    "file://.python-version",
    "file://src/**/*.py",
    "file://app/**/*.py",
    "file://lib/**/*.py",
    "file://tests/**/*.py",
    "file://docs/**/*.md",
    "file:///home/mike/.kiro/steering/linear-standards.md",
    "skill://~/.kiro/skills/*/SKILL.md",
    "file:///home/mike/.kiro/steering/shell-safety-standards.md"
  ],
  "model": "auto",
  "welcomeMessage": "Ready to help with Python 3 development: implementation, debugging, refactoring, testing, and code quality.",
  "permissions": {
    "rules": [
      {
        "capability": "shell",
        "match": [
          "python",
          "python3",
          "pip",
          "pip3",
          "pytest",
          "mypy",
          "ruff",
          "black",
          "isort",
          "tox",
          "poetry",
          "pdm",
          "uv",
          "curl",
          "wget",
          "git status",
          "git fetch",
          "git log",
          "git diff",
          "git branch",
          "git checkout",
          "git switch",
          "git add",
          "git commit",
          "git pull",
          "git stash",
          "git tag",
          "git show",
          "git rev-parse",
          "trash-put",
          "trash-list",
          "trash-restore"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "bash",
          "bash *",
          "dash",
          "dash *",
          "find *-delete",
          "find *-exec rm*",
          "find *-execdir rm*",
          "git branch *-D*",
          "git clean *-*f*",
          "git clean *-f*",
          "git push",
          "git push *",
          "git reset *--hard*",
          "rm",
          "rm *",
          "rmdir",
          "rmdir *",
          "sh",
          "sh *",
          "shred",
          "shred *",
          "sudo",
          "sudo *",
          "unlink",
          "unlink *",
          "zsh",
          "zsh *"
        ],
        "effect": "deny"
      },
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "skill",
        "effect": "allow"
      }
    ],
    "policies": [
      "read-only-shell"
    ]
  },
  "kiroUpgrade": {
    "revision": 2,
    "fingerprint": "sha256:e7435ead182e9899b2e581483d9d8930d8f43f6d19e7ec06a5ab5a63f21d7e4e",
    "source": "sha256:7dee024675cb28dd8bac1319b28288180f0eb0d5c272a72ed7f00c33adeb8dd4"
  }
}
