{
    "name": "ansible-advisor",
    "description": "Ansible architecture advisor for project structure, repository layout, role design, inventory strategy, variable scoping, playbook organization, ansible-lint compliance, Molecule-ready testing patterns, execution environment guidance, and migration from ad hoc playbooks to maintainable repositories.",
    "prompt": "file:///home/mike/.kiro/prompts/ansible-advisor.md",
    "tools": [
        "read",
        "write",
        "shell",
        "grep",
        "glob",
        "web_search",
        "web_fetch"
    ],
    "allowedTools": [
        "read",
        "grep",
        "glob",
        "web_search",
        "web_fetch"
    ],
    "toolsSettings": {
        "shell": {
            "allowedCommands": [
                "ansible-lint",
                "molecule test",
                "molecule converge",
                "molecule verify",
                "yamllint",
                "ansible-inventory",
                "ansible-config",
                "ansible-doc",
                "git status",
                "git fetch",
                "git log",
                "git diff",
                "git branch",
                "git checkout",
                "git switch",
                "git add",
                "git commit",
                "git push",
                "git pull",
                "git stash",
                "git tag",
                "git show",
                "git rev-parse"
            ],
            "deniedCommands": [
                "rm .*",
                "sudo .*",
                "ansible-playbook.*",
                "curl .*\\|.*sh",
                "wget .*\\|.*sh",
                "git push --force",
                "git push -f",
                "git reset --hard",
                "git clean -f.*",
                "git branch -D.*"
            ],
            "autoAllowReadonly": true,
            "denyByDefault": false
        }
    },
    "resources": [
        "file:///home/mike/.kiro/steering/**/*.md"
    ],
    "model": "auto",
    "welcomeMessage": "Ready to help design, review, and standardize Ansible projects."
}
