{
    "name": "ansible-advisor",
    "description": "Ansible architecture advisor for project structure, repository layout, role design, inventory strategy, variable scoping, playbook organization, ansible-lint compliance, Molecule-ready testing patterns, execution environment guidance, and migration from ad hoc playbooks to maintainable repositories.",
    "prompt": "file:///home/mike/.kiro/prompts/ansible-advisor.md",
    "tools": [
        "@linear",
        "read",
        "write",
        "shell",
        "grep",
        "glob",
        "web_search",
        "web_fetch"
    ],
    "allowedTools": [
        "read",
        "grep",
        "glob",
        "web_search",
        "web_fetch"
    ],
    "toolsSettings": {
        "shell": {
            "allowedCommands": [
                "ansible-lint",
                "molecule test",
                "molecule converge",
                "molecule verify",
                "yamllint",
                "ansible-inventory",
                "ansible-config",
                "ansible-doc",
                "git status",
                "git fetch",
                "git log",
                "git diff",
                "git branch",
                "git checkout",
                "git switch",
                "git add",
                "git commit",
                "git push",
                "git pull",
                "git stash",
                "git tag",
                "git show",
                "git rev-parse"
            ],
            "deniedCommands": [
                "ansible-playbook.*",
                "sudo.*",
                "rm.*-[a-zA-Z]*[rf].*",
                "(curl|wget).*\\|.*(sh|bash|zsh|dash).*",
                "git push.*(--force|-f).*",
                "git reset.*--hard.*",
                "git clean.*-[a-zA-Z]*f.*",
                "git branch.*-D.*"
            ],
            "autoAllowReadonly": true,
            "denyByDefault": false
        }
    },
    "resources": [
        "file://README.md",
        "file://ansible.cfg",
        "file://site.yml",
        "file://playbooks/**/*.yml",
        "file://playbooks/**/*.yaml",
        "file://roles/**/*.yml",
        "file://roles/**/*.yaml",
        "file://inventory/**/*",
        "file://group_vars/**/*",
        "file://host_vars/**/*",
        "file://molecule/**/*",
        "file://.ansible-lint",
        "file://.yamllint",
        "file:///home/mike/.kiro/steering/linear-standards.md",
        "file:///home/mike/.kiro/steering/conventional-commit-standards.md",
        "file:///home/mike/.kiro/steering/ansible-security-standards.md",
        "skill://~/.kiro/skills/*/SKILL.md"
    ],
    "model": "auto",
    "welcomeMessage": "Ready to help design, review, and standardize Ansible projects."
}
